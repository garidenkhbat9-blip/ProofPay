# Optional server-only integration settings. Copy values into .env.local.
# Never use NEXT_PUBLIC_ for these values. Do not commit a populated copy.
GEMINI_API_KEY=
# Override this if your Gemini project uses another supported structured-output model.
GEMINI_MODEL=gemini-3.8-flash

# Website verification remains reserved for a later integration.
BROWSERLESS_API_TOKEN=
# Required for payment server RPCs; never expose this key to browser code.
SUPABASE_SECRET_KEY=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Direct merchant mode only: this REST app must belong to this freelancer.
# The matching database merchant binding must be independently verified/enabled.
PAYPAL_MERCHANT_ID=
PAYPAL_MERCHANT_EMAIL=
PAYPAL_FREELANCER_USER_ID=
